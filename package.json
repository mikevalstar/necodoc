{
  "name": "necodoc",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check": "biome check .",
    "fix": "biome check --write .",
    "db:generate": "pnpm --filter @necodoc/api db:generate",
    "db:migrate": "pnpm --filter @necodoc/api db:migrate",
    "docs:check": "okq --bundle docs validate && okq --bundle docs deadlinks && okq --bundle docs lint",
    "sdk:generate": "node scripts/generate-sdks.ts",
    "bench": "pnpm --filter @necodoc/bench bench",
    "demo:seed": "pnpm --filter @necodoc/demo seed",
    "demo:screens": "pnpm --filter @necodoc/demo screens",
    "review-pack": "pnpm --filter @necodoc/review-pack generate",
    "release:assets": "pnpm --filter @necodoc/review-pack generate --release"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  }
}
