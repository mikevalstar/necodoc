{
  "kind": "designed",
  "name": "Oregon Contractor License Bond",
  "description": "A surety bond for Oregon construction contractors, filed in favor of the Construction Contractors Board (CCB) to support the contractor's license under ORS Chapter 701. The contractor or their surety agent fills it in, entering the contractor, surety, bond number, penal sum, and dates. The license endorsement chosen is cited in the bond's conditions. Turning on the co-principal option makes a second party jointly and severally bound and adds a second signature block.",
  "sections": [
    {
      "title": "Principal (contractor)",
      "fields": [
        {
          "key": "principal_name",
          "type": "text",
          "label": "Principal legal name",
          "required": true
        },
        {
          "key": "principal_address",
          "type": "long_text",
          "label": "Principal address",
          "required": true
        },
        {
          "key": "ccb_license_number",
          "type": "text",
          "label": "CCB license number",
          "required": true
        },
        {
          "key": "license_type",
          "type": "choice",
          "label": "License endorsement",
          "options": [
            {
              "label": "Residential General Contractor",
              "value": "Residential General Contractor"
            },
            {
              "label": "Residential Specialty Contractor",
              "value": "Residential Specialty Contractor"
            },
            {
              "label": "Commercial General Contractor Level 1",
              "value": "Commercial General Contractor Level 1"
            },
            {
              "label": "Commercial General Contractor Level 2",
              "value": "Commercial General Contractor Level 2"
            },
            {
              "label": "Commercial Specialty Contractor",
              "value": "Commercial Specialty Contractor"
            }
          ],
          "multiple": false,
          "required": true
        },
        {
          "key": "principal_signatory",
          "type": "text",
          "label": "Principal signatory name",
          "required": true
        },
        {
          "key": "principal_signatory_title",
          "type": "text",
          "label": "Principal signatory title",
          "required": false
        }
      ],
      "description": "The licensed contractor who is bonded."
    },
    {
      "title": "Co-principal",
      "fields": [
        {
          "key": "has_co_principal",
          "help": "Turn on to name a co-principal and add a second principal signature block.",
          "type": "boolean",
          "label": "Add a co-principal",
          "default": false,
          "required": false
        },
        {
          "key": "co_principal_name",
          "type": "text",
          "label": "Co-principal legal name",
          "showIf": {
            "op": "equals",
            "field": "has_co_principal",
            "value": true
          },
          "required": true
        },
        {
          "key": "co_principal_address",
          "type": "long_text",
          "label": "Co-principal address",
          "showIf": {
            "op": "equals",
            "field": "has_co_principal",
            "value": true
          },
          "required": true
        },
        {
          "key": "co_principal_signatory",
          "type": "text",
          "label": "Co-principal signatory name",
          "showIf": {
            "op": "equals",
            "field": "has_co_principal",
            "value": true
          },
          "required": true
        },
        {
          "key": "co_principal_signatory_title",
          "type": "text",
          "label": "Co-principal signatory title",
          "showIf": {
            "op": "equals",
            "field": "has_co_principal",
            "value": true
          },
          "required": false
        }
      ],
      "description": "Optional second principal who is jointly bound under the bond."
    },
    {
      "title": "Surety",
      "fields": [
        {
          "key": "surety_name",
          "type": "text",
          "label": "Surety company name",
          "required": true
        },
        {
          "key": "surety_address",
          "type": "long_text",
          "label": "Surety address",
          "required": true
        },
        {
          "key": "attorney_in_fact",
          "type": "text",
          "label": "Attorney-in-fact name",
          "required": true
        }
      ],
      "description": "The surety company issuing the bond."
    },
    {
      "title": "Obligee",
      "fields": [
        {
          "key": "obligee_name",
          "type": "text",
          "label": "Obligee name",
          "default": "State of Oregon, Construction Contractors Board",
          "required": true
        },
        {
          "key": "obligee_address",
          "type": "long_text",
          "label": "Obligee address",
          "required": false
        }
      ],
      "description": "The party protected by the bond."
    },
    {
      "title": "Bond terms",
      "fields": [
        {
          "key": "bond_number",
          "type": "text",
          "label": "Bond number",
          "required": true
        },
        {
          "key": "penal_sum",
          "min": 0,
          "help": "Total amount of the bond.",
          "type": "number",
          "label": "Penal sum (USD)",
          "decimals": 2,
          "required": true
        },
        {
          "key": "effective_date",
          "type": "date",
          "label": "Effective date",
          "required": true
        },
        {
          "key": "execution_date",
          "type": "date",
          "label": "Date executed",
          "required": true
        }
      ]
    }
  ],
