{
  "kind": "overlay",
  "name": "OR CCB Commercial Surety Bond",
  "description": "Oregon Construction Contractors Board commercial contractor bond (Rev 08/2023), filled on the board’s own PDF. Two pages: the bond and the board’s checklist.",
  "sections": [
    {
      "title": "Principal",
      "fields": [
        {
          "type": "text",
          "key": "principal_name",
          "label": "Principal legal name",
          "required": true,
          "help": "Exactly as registered with the Corporation Division."
        },
        {
          "type": "text",
          "key": "ccb_number",
          "label": "CCB number (if already issued)",
          "required": false
        },
        {
          "type": "email",
          "key": "principal_email",
          "label": "Principal contact email",
          "required": false
        }
      ]
    },
    {
      "title": "Bond",
      "fields": [
        {
          "type": "text",
          "key": "bond_number",
          "label": "Surety bond number",
          "required": true
        },
        {
          "type": "text",
          "key": "penal_sum",
          "label": "Penal sum (USD)",
          "required": true,
          "help": "Written as on the license endorsement, e.g. 50,000.00"
        },
        {
          "type": "text",
          "key": "surety_name",
          "label": "Surety company",
          "required": true,
          "default": "Harbour Surety Company"
        }
      ]
    },
    {
      "title": "Execution",
      "fields": [
        {
          "type": "text",
          "key": "dated_day",
          "label": "Dated: day",
          "required": true
        },
        {
          "type": "text",
          "key": "dated_month",
          "label": "Dated: month",
          "required": true
        },
        {
          "type": "text",
          "key": "dated_year",
          "label": "Dated: year (two digits)",
          "required": true
        },
        {
          "type": "text",
          "key": "attorney_name",
          "label": "Attorney-in-fact or agent",
          "required": true
        },
        {
          "type": "text",
          "key": "attorney_title",
          "label": "Title",
          "required": false
        },
        {
          "type": "email",
          "key": "attorney_email",
          "label": "Attorney-in-fact email",
          "required": false
        },
        {
          "type": "text",
          "key": "agency_address",
          "label": "Agency address and phone",
          "required": false
        },
        {
          "type": "text",
          "key": "agency_city_state_zip",
          "label": "Agency city, state, ZIP",
          "required": false
        }
      ]
    }
  ],
