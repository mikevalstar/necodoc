  "content": {
    "css": ".necodoc-band { display: flex; align-items: center; gap: 4mm; font-size: 8pt; color: #374151; }\n.necodoc-band img { height: 14mm; width: auto; }\n.necodoc-band p { margin: 0; flex: 1; }\ntd p, th p { margin: 0; }\ntable.signatures { width: 100%; margin-top: 16mm; border: none; }\ntable.signatures td { width: 50%; border: none; padding: 0 6mm 0 0; vertical-align: bottom; }\ntable.signatures tr + tr td { border-top: 0.6pt solid #111; padding-top: 2mm; }",
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 1,
            "textAlign": "center"
          },
          "content": [
            {
              "text": "Certificate of Surety Bond (Ontario)",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": "center"
          },
          "content": [
            {
              "text": "Bond No. ",
              "type": "text"
            },
            {
              "type": "mergeField",
              "attrs": {
                "field": "bond_number",
                "filter": null
              }
            },
            {
              "text": "  ·  Effective ",
              "type": "text"
            },
            {
              "type": "mergeField",
              "attrs": {
                "field": "effective_date",
                "filter": {
                  "name": "date",
                  "format": "MMM D, YYYY"
                }
              }
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": "justify"
          },
          "content": [
            {
              "text": "KNOW ALL PERSONS BY THESE PRESENTS, that ",
              "type": "text"
            },
            {
              "type": "mergeField",
              "attrs": {
                "field": "principal",
                "filter": null
              }
            },
            {
              "text": ", as Principal, and Harbour Surety Company, a corporation licensed to transact surety business in the Province of Ontario, as Surety, are held and firmly bound unto ",
              "type": "text"
            },
            {
              "type": "mergeField",
              "attrs": {
                "field": "obligee",
                "filter": null
              }
            },
            {
              "text": ", as Obligee, in the penal sum of ",
              "type": "text"
            },
            {
              "type": "mergeField",
              "attrs": {
                "field": "bond_amount",
                "filter": {
                  "name": "currency",
                  "currency": "CAD"
                }
              }
            },
            {
              "text": ", for the payment of which sum the Principal and the Surety bind themselves, their heirs, executors, administrators, successors and assigns, jointly and severally.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": "justify"
          },
          "content": [
            {
              "text": "This bond is issued as a ",
              "type": "text"
            },
            {
              "type": "mergeField",
              "attrs": {
                "field": "bond_type",
                "filter": {
                  "name": "upcase"
                }
              }
            },
            {
              "text": " for the contracts listed in the schedule below. The Surety's aggregate liability under this bond shall not exceed the penal sum stated above, regardless of the number of contracts covered.",
              "type": "text"
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": "left"
          },
          "content": [
            {
              "text": "Schedule of covered contracts",
              "type": "text"
            }
          ]
        },
        {
          "type": "table",
          "content": [
            {
              "type": "tableRow",
              "attrs": {
                "repeat": null
              },
              "content": [
                {
                  "type": "tableHeader",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "textAlign": null
                      },
                      "content": [
                        {
                          "text": "Contract",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "tableHeader",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "textAlign": null
                      },
                      "content": [
                        {
                          "text": "Description",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "tableHeader",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "textAlign": null
                      },
                      "content": [
                        {
                          "text": "Contract value",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "attrs": {
                "repeat": "covered_contracts"
              },
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "textAlign": null
                      },
                      "content": [
                        {
                          "type": "mergeField",
                          "attrs": {
                            "field": "covered_contracts.contract_number",
                            "filter": null
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "textAlign": null
                      },
                      "content": [
                        {
                          "type": "mergeField",
                          "attrs": {
                            "field": "covered_contracts.description",
                            "filter": null
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "textAlign": null
                      },
                      "content": [
                        {
                          "type": "mergeField",
                          "attrs": {
                            "field": "covered_contracts.contract_value",
                            "filter": {
                              "name": "currency",
                              "currency": "CAD"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "text": "The Principal shall faithfully perform each contract in the schedule according to its terms. Should the Principal default, the Surety shall promptly remedy the default, complete the contract, or pay the Obligee up to the penal sum.",
              "type": "text"
            }
          ]
        },
        {
          "type": "conditionalSection",
          "attrs": {
            "condition": {
              "op": "is_set",
              "field": "include_rider"
            }
          },
          "content": [
            {
              "type": "heading",
              "attrs": {
                "level": 2,
                "textAlign": null
              },
              "content": [
                {
                  "text": "Rider",
                  "type": "text"
                }
              ]
            },
            {
              "type": "paragraph",
              "attrs": {
                "textAlign": null
              },
              "content": [
                {
                  "type": "mergeField",
                  "attrs": {
                    "field": "rider_wording",
                    "filter": {
                      "name": "lines"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "pageBreak"
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "textAlign": null
          },
          "content": [
            {
              "text": "Conditions of this bond",
              "type": "text",
              "marks": [
                {
                  "type": "textStyle",
                  "attrs": {
                    "color": null
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "start": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "text": "The Surety shall not be liable for any amount greater than the penal sum, and any payment made under this bond reduces the penal sum by that amount.",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "text": "No right of action shall accrue under this bond to or for the use of any person other than the Obligee named herein, or its successors and assigns.",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "text": "Any suit under this bond must be instituted within two years from the date on which final payment under the contract falls due.",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "text": "Notice of any default by the Principal shall be given to the Surety in writing within thirty days after the Obligee becomes aware of the default.",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "textAlign": null
                  },
                  "content": [
                    {
                      "text": "Changes to the contract, extensions of time, or other forbearance granted to the Principal do not release the Surety from its obligations under this bond.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "text": "Signed, sealed and dated ",
              "type": "text"
            },
            {
              "type": "mergeField",
              "attrs": {
                "field": "effective_date",
                "filter": {
                  "name": "date",
                  "format": "MMMM D, YYYY"
                }
              }
            },
            {
              "text": ", on behalf of Harbour Surety Company.",
              "type": "text"
            }
          ]
        },
        {
          "type": "rawHtml",
          "attrs": {
            "html": "<table class=\"signatures\">\n  <tr>\n    <td></td>\n    <td>{% if signature != blank %}<img src=\"{{ signature }}\" style=\"height:16mm\">{% endif %}</td>\n  </tr>\n  <tr>\n    <td>{{ principal }}<br><small>Principal</small></td>\n    <td>{{ attorney_in_fact }}<br><small>Attorney-in-fact, Harbour Surety Company</small></td>\n  </tr>\n</table>"
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "text": "Issued in duplicate; each copy is an original.",
              "type": "text"
            }
          ]
        },
        {
          "type": "snippet",
          "attrs": {
            "snippetId": "$snippet:surety-indemnity-clause"
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "text": "Principal: ",
              "type": "text"
            },
            {
              "type": "signBox",
              "attrs": {
                "kind": "signature",
                "width": 60,
                "height": 15,
                "required": true,
                "signerId": "principal"
              }
            },
            {
              "text": "  Date: ",
              "type": "text"
            },
            {
              "type": "signBox",
              "attrs": {
                "kind": "date_signed",
                "width": 35,
                "height": 8,
                "required": true,
                "signerId": "principal"
              }
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "textAlign": null
          },
          "content": [
            {
              "text": "Attorney-in-fact: ",
              "type": "text"
            },
            {
              "type": "signBox",
              "attrs": {
                "kind": "signature",
                "width": 60,
                "height": 15,
                "required": true,
                "signerId": "attorney_in_fact"
              }
            }
          ]
        }
      ]
    },
