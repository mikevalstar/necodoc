{
  "kind": "designed",
  "name": "Surety Bond Certificate",
  "description": "Performance bond certificate with schedule of obligees and rider clauses.",
  "sections": [
    {
      "title": "Bond details",
      "fields": [
        {
          "key": "bond_number",
          "help": "As printed on the bond, e.g. SB-204518",
          "type": "text",
          "label": "Bond number",
          "pattern": "SB-\\d{6}",
          "required": true
        },
        {
          "key": "principal",
          "type": "text",
          "label": "Principal",
          "required": true
        },
        {
          "key": "principal_address",
          "type": "long_text",
          "label": "Principal address",
          "required": false
        },
        {
          "key": "obligee",
          "type": "text",
          "label": "Obligee",
          "required": true
        },
        {
          "key": "effective_date",
          "type": "date",
          "label": "Effective date",
          "required": true
        },
        {
          "key": "bond_amount",
          "min": 0,
          "type": "number",
          "label": "Bond amount",
          "decimals": 2,
          "required": true
        },
        {
          "key": "bond_type",
          "type": "choice",
          "label": "Bond type",
          "default": "Performance bond",
          "options": [
            {
              "label": "Performance bond",
              "value": "Performance bond"
            },
            {
              "label": "Payment bond",
              "value": "Payment bond"
            },
            {
              "label": "Bid bond",
              "value": "Bid bond"
            }
          ],
          "multiple": false,
          "required": false
        },
        {
          "key": "surety_company",
          "type": "text",
          "label": "Surety company",
          "default": "Harbour Surety Company",
          "required": false
        }
      ]
    },
    {
      "title": "Schedule",
      "fields": [
        {
          "key": "covered_contracts",
          "type": "group",
          "label": "Covered contracts",
          "fields": [
            {
              "key": "contract_number",
              "type": "text",
              "label": "Contract number",
              "required": false
            },
            {
              "key": "description",
              "type": "text",
              "label": "Description",
              "required": false
            },
            {
              "key": "contract_value",
              "type": "number",
              "label": "Contract value",
              "decimals": 2,
              "required": false
            }
          ],
          "required": true
        },
        {
          "key": "include_rider",
          "type": "boolean",
          "label": "Include rider",
          "required": false
        },
        {
          "key": "rider_wording",
          "type": "long_text",
          "label": "Rider wording",
          "showIf": {
            "op": "is_set",
            "field": "include_rider"
          },
          "required": true
        }
      ]
    },
    {
      "title": "Signing",
      "fields": [
        {
          "key": "attorney_in_fact",
          "type": "text",
          "label": "Attorney-in-fact",
          "required": false
        },
        {
          "key": "signature",
          "type": "signature",
          "label": "Signature",
          "required": true
        }
      ]
    }
  ],
  "sampleData": {
    "obligee": "City of Hamilton, Public Works Department",
    "bond_type": "Performance bond",
    "principal": "Northwind Construction Ltd.",
    "signature": "data:image/png;base64,",
    "bond_amount": 2450000,
    "bond_number": "SB-204518",
    "include_rider": true,
    "rider_wording": "The Surety consents to the extension of the completion date to June 30, 2027.\nAll other terms and conditions of the bond remain unchanged.",
    "effective_date": "2026-11-02",
    "attorney_in_fact": "Margaret L. Chen",
    "covered_contracts": [
      {
        "description": "Main Street watermain replacement, phase 2",
        "contract_value": 1250000,
        "contract_number": "PW-2026-114"
      },
      {
        "description": "Bayfront park storm sewer outfall",
        "contract_value": 640000,
        "contract_number": "PW-2026-131"
      },
      {
        "description": "Barton Street resurfacing and curb works",
        "contract_value": 385500.5,
        "contract_number": "PW-2026-147"
      },
      {
        "description": "Pumping station 7 electrical upgrade",
        "contract_value": 174499.5,
