{
  "name": "@necodoc/api",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "worker": "ROLE=worker PORT=${PORT:-3100} tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "start:worker": "ROLE=worker node --env-file-if-exists=.env dist/index.mjs",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "openapi": "tsx src/openapi.ts",
    "storage:migrate": "tsx --env-file-if-exists=.env src/storage-migrate.ts",
    "chromium:install": "playwright-core install --only-shell chromium"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "auth": "^1.7.6",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@better-auth/api-key": "1.7.6",
    "@better-auth/sso": "1.7.6",
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@hono/standard-validator": "^0.4.0",
    "@hono/zod-validator": "^0.9.1",
    "@napi-rs/canvas": "^1.0.11",
    "@necodoc/shared": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@prometheus-io/client": "^0.16.1",
    "@standard-community/standard-json": "^0.3.6",
    "@standard-community/standard-openapi": "^0.2.10",
    "@standard-schema/spec": "^1.1.0",
    "@types/json-schema": "^7.0.15",
    "ai": "^7.0.137",
    "asn1js": "^3.0.10",
    "better-auth": "^1.7.6",
    "bwip-js": "^4.11.4",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.9",
    "hono-openapi": "^1.3.5",
    "liquidjs": "^10.30.0",
    "openapi-types": "^12.1.3",
    "pdfjs-dist": "^6.4.299",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pkijs": "^3.4.1",
    "playwright-core": "~1.62.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
