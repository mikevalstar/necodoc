DATABASE_URL=postgres://necodoc:necodoc@localhost:5432/necodoc
BETTER_AUTH_SECRET=change-me-to-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:5173
PORT=3000
# ADR 0020: api | worker | all. Workers render queued jobs; `pnpm worker` starts one (PORT 3100).
ROLE=all
RENDER_CONCURRENCY=2
# How long a synchronous generate call waits before answering 202 with the generation id.
RENDER_WAIT_MS=30000
PREVIEW_CONCURRENCY=2
APP_VERSION=dev
# The sidebar and login page label: name, and prod | staging | dev | demo. Unset hides it.
# INSTANCE_NAME=Harbour Surety
# INSTANCE_ENV=dev                 # prod | staging | dev | demo
# Public demo only (docs/features/public-demo.md): every visitor is signed in as one shared
# demo admin, no login. Never on an install with real data.
# DEMO_MODE=false
# Nightly reset (ADR 0045): when `pnpm demo:reset` is scheduled, for the banner's countdown.
# HH:MM in DEMO_RESET_TZ; must match the cron line. Unset: no countdown.
# DEMO_RESET_TIME=00:00
# DEMO_RESET_TZ=America/Toronto
# Demo limits per client address (ADR 0046); a burst of N, refilled evenly. AI counts per day.
# DEMO_RENDERS_PER_MINUTE=30
# DEMO_UPLOADS_PER_HOUR=30
# DEMO_BATCHES_PER_HOUR=10
# DEMO_BATCH_MAX_ROWS=25
# DEMO_UPLOAD_MAX_MB=5             # every request body, uploads included
# DEMO_SIGNINS_PER_HOUR=30
# DEMO_AI_PER_IP_PER_DAY=20        # with ANTHROPIC_KEY set; 0 turns AI off in the demo
# DEMO_AI_PER_DAY=300

# ADR 0023: where generated PDFs go. disk (default) | s3 | azure. Base data stays in Postgres.
STORAGE_DRIVER=disk
# disk: relative to apps/api. Several hosts need a shared mount (NFS, EFS, Azure Files).
STORAGE_DIR=./data/files
# s3 and azure: optional key prefix, e.g. necodoc/outputs
# STORAGE_PREFIX=
# s3 (AWS, MinIO, R2): leave the keys unset to use the AWS default credential chain / IAM role.
# S3_BUCKET=necodoc
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_SSE=AES256            # or aws:kms
# S3_KMS_KEY_ID=           # with S3_SSE=aws:kms; unset uses the AWS-managed key
# azure: a connection string, or an account with a key, or an account alone for DefaultAzureCredential.
# AZURE_STORAGE_CONTAINER=necodoc
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_ACCOUNT_URL=   # defaults to https://<account>.blob.core.windows.net
# off | presigned: redirect downloads to an S3 presigned URL / Azure SAS instead of proxying.
STORAGE_REDIRECT=off
# Signs download links; defaults to BETTER_AUTH_SECRET. Rotating it voids live links.
# DOWNLOAD_SIGNING_SECRET=

# Behind reverse proxies, how many there are (true = 1; the app image's nginx counts as one), to
# read the client address from X-Forwarded-For (share-link rate limit, API key IP allowlists).
# TRUST_PROXY=2

# Development only: let webhooks POST to http:// and loopback URLs (a local receiver).
# WEBHOOK_ALLOW_LOCALHOST=true

# ADR 0022: AI features (field detection) are on only with a key; workers need it too.
# ANTHROPIC_KEY=
# AI_MODEL=claude-sonnet-5-5

# ADR 0038: certify PDFs (PAdES, DocMDP) with the organisation's certificate; workers need it.
# A PKCS#12 file, or PEM certificate (+ chain) and key files. fixtures/certs has a TEST-ONLY pair.
# CERTIFY_P12_PATH=/run/secrets/certify.p12
# CERTIFY_CERT_PATH=
# CERTIFY_KEY_PATH=
# CERTIFY_PASSWORD=
# CERTIFY_TSA_URL=http://timestamp.digicert.com   # RFC 3161; B-T with it, B-B without

# --- Sign-in (ADR 0031) --- guides: apps/devdocs self-hosting/sso
# AUTH_PASSWORD_ENABLED=true       # false: SSO only (needs SSO_PROVIDERS)
# SSO_PROVIDERS=entra              # comma list of ids; each id reads SSO_<ID>_* below
# SSO_ENTRA_TYPE=oidc              # oidc | saml | header
# SSO_ENTRA_LABEL=Microsoft
# SSO_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SSO_ENTRA_CLIENT_ID=
# SSO_ENTRA_CLIENT_SECRET=
# SSO_ENTRA_ROLE_MAP='{"<admins-group-id>":["admin"],"<editors-group-id>":["editor","reviewer"]}'
# SSO_ENTRA_DEFAULT_ROLES=         # roles for users in no mapped group; empty = pending
# SSO_ENTRA_LINK_EXISTING=false    # true: may sign in as an existing user with the same email
# SSO_ENTRA_EMAIL_DOMAINS=example.com
