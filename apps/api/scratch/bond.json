{
  "kind": "designed",
  "name": "Oregon Contractor License Surety Bond",
  "description": "Surety bond for an Oregon construction contractor licence, naming the principal, surety and obligee, with penal sum and effective date.",
  "sections": [
    {
      "title": "Bond details",
      "description": "Core terms of the bond.",
      "fields": [
        {
          "type": "text",
          "key": "bond_number",
          "label": "Bond number",
          "required": true
        },
        {
          "type": "choice",
          "key": "license_type",
          "label": "Licence endorsement",
          "required": true,
          "options": [
            {
              "value": "residential_general",
              "label": "Residential general contractor"
            },
            {
              "value": "residential_specialty",
              "label": "Residential specialty contractor"
            },
            {
              "value": "residential_limited",
              "label": "Residential limited contractor"
            },
            {
              "value": "commercial_level_1",
              "label": "Commercial Level 1"
            },
            {
              "value": "commercial_level_2",
              "label": "Commercial Level 2"
            },
            {
              "value": "commercial_specialty",
              "label": "Commercial specialty contractor"
            }
          ],
          "multiple": false
        },
        {
          "type": "number",
          "key": "penal_sum",
          "label": "Penal sum (USD)",
          "help": "Total liability of the surety under the bond.",
          "required": true,
          "min": 0,
          "decimals": 2
        },
        {
          "type": "text",
          "key": "penal_sum_words",
          "label": "Penal sum in words",
          "help": "e.g. Twenty Thousand and 00/100 Dollars",
          "required": true
        },
        {
          "type": "date",
          "key": "effective_date",
          "label": "Effective date",
          "required": true
        }
      ]
    },
    {
      "title": "Principal (contractor)",
      "fields": [
        {
          "type": "text",
          "key": "principal_name",
          "label": "Legal name of contractor",
          "required": true
        },
        {
          "type": "text",
          "key": "principal_dba",
          "label": "Business / trade name (if different)",
          "required": false
        },
        {
          "type": "choice",
          "key": "principal_entity_type",
          "label": "Entity type",
          "required": true,
          "options": [
            {
              "value": "sole_proprietorship",
              "label": "Sole proprietorship"
            },
            {
              "value": "partnership",
              "label": "Partnership"
            },
            {
              "value": "llc",
              "label": "Limited liability company"
            },
            {
              "value": "corporation",
              "label": "Corporation"
            }
          ],
          "multiple": false
        },
        {
          "type": "text",
          "key": "ccb_license_number",
          "label": "CCB licence number",
          "help": "Leave blank if the licence has not yet been issued.",
          "required": false
        },
        {
          "type": "long_text",
          "key": "principal_address",
          "label": "Principal business address",
          "required": true
        },
        {
          "type": "text",
          "key": "principal_signatory_name",
          "label": "Signatory name",
          "required": true
        },
        {
          "type": "text",
          "key": "principal_signatory_title",
          "label": "Signatory title",
          "required": false,
          "showIf": {
            "field": "principal_entity_type",
            "op": "not_equals",
            "value": "sole_proprietorship"
          }
        }
      ]
    },
    {
      "title": "Surety",
      "fields": [
        {
          "type": "text",
          "key": "surety_name",
          "label": "Surety company name",
          "required": true
        },
        {
          "type": "text",
          "key": "surety_state",
          "label": "State of incorporation",
          "required": true
        },
        {
          "type": "long_text",
          "key": "surety_address",
          "label": "Surety address",
          "required": true
        },
        {
          "type": "text",
          "key": "attorney_in_fact_name",
          "label": "Attorney-in-fact",
          "required": true
        }
      ]
    },
    {
      "title": "Obligee",
      "fields": [
        {
          "type": "text",
          "key": "obligee_name",
          "label": "Obligee name",
          "required": true,
          "default": "State of Oregon, Construction Contractors Board"
        },
        {
          "type": "long_text",
          "key": "obligee_address",
          "label": "Obligee address",
          "required": true,
          "default": "700 Summer Street NE, Suite 300, Salem, Oregon 97301"
        }
      ]
    },
    {
      "title": "Execution",
      "fields": [
        {
          "type": "date",
          "key": "execution_date",
          "label": "Date of execution",
          "required": true
        }
      ]
    }
  ],
