          "content": [
            {
              "type": "text",
              "text": "1. Licence and Purpose"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The Principal has applied for or holds a licence with the "
            },
            {
              "type": "mergeField",
              "attrs": {
                "field": "license_type",
                "filter": null
              }
            },
            {
              "type": "text",
              "text": " endorsement issued by the Oregon Construction Contractors Board under ORS Chapter 701. This bond is given to satisfy the bonding requirement for that licence."
            },
            {
              "type": "text",
              "text": " "
            }
          ]
        },
        {
          "type": "conditionalSection",
          "attrs": {
            "condition": {
              "field": "ccb_license_number",
              "op": "is_set"
            }
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The Principal’s CCB licence number is "
                },
                {
                  "type": "mergeField",
                  "attrs": {
                    "field": "ccb_license_number",
                    "filter": null
                  },
                  "marks": [
                    {
                      "type": "bold"
                    }
