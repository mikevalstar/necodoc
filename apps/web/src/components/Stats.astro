---
// A row of figures between hairlines. Children are <Stat>s.
---

<div class="stats"><slot /></div>

<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--hair); border-bottom: 1px solid var(--hair); }
  .stats > :global(*) { padding: 30px 28px 28px 0; }
  .stats > :global(* + *) { padding-left: 28px; border-left: 1px solid var(--hair); }
  @media (max-width: 1100px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stats > :global(:nth-child(3)) { padding-left: 0; border-left: 0; }
    .stats > :global(:nth-child(n + 3)) { border-top: 1px solid var(--hair); }
  }
  @media (max-width: 640px) {
    .stats { grid-template-columns: 1fr; }
    .stats > :global(*) { padding: 22px 0 !important; border-left: 0 !important; }
    .stats > :global(* + *) { border-top: 1px solid var(--hair); }
  }
</style>
