---
import { footerNav } from "../lib/nav";
import Mark from "./Mark.astro";
---

<footer>
  <div class="wrap">
    <div class="cols">
      <div class="about">
        <a class="logo" href="/"><Mark />necodoc</a>
        <p>
          Document generation for P&amp;C and surety carriers, run on your own infrastructure. MIT-licensed. We don't host
          it, so we never hold your data.
        </p>
      </div>
      {
        footerNav.map((group) => (
          <div>
            <h4>{group.title}</h4>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>
                    {item.label}
                    {item.external && " ↗"}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="base">
      <span>MIT licence</span><span>Nothing phones home</span>
      <span class="r">EN · <a href="/fr/" lang="fr-CA" hreflang="fr-CA">Français</a></span>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--night-deep); color: var(--night-fg-2); padding: 72px 0 40px; font-size: 14.5px; border-top: 1px solid var(--night-hair); }
  .cols { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 40px; }
  h4 { font: 500 12px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: #8f9bd6; margin: 0 0 14px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; }
  a { text-decoration: none; color: var(--night-fg); }
  a:hover { text-decoration: underline; }
  .logo { display: flex; align-items: center; gap: 10px; font: 700 22px/1 var(--display); letter-spacing: -.02em; color: #fff; }
  .logo:hover { text-decoration: none; }
  .about p { margin-top: 16px; line-height: 1.6; max-width: 320px; }
  .base { margin-top: 56px; padding-top: 22px; border-top: 1px solid var(--night-hair); display: flex; gap: 24px; font: 12.5px var(--mono); color: #8f9bd6; }
  .r { margin-left: auto; }
  @media (max-width: 1100px) {
    .cols { grid-template-columns: repeat(3, 1fr); }
    .about { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .cols { grid-template-columns: 1fr 1fr; }
    .base { flex-direction: column; gap: 6px; }
    .r { margin-left: 0; }
  }
</style>
