---
// Security and governance. Its job (docs/features/marketing-site.md, Pages): identity, keys,
// data residency, audit, privacy, change control and output integrity; the controls list a
// security reviewer copies into a questionnaire; the AI data caveat.
import auditDetail from "../assets/screens/audit-detail.png";
import audit from "../assets/screens/audit-log.png";
import gallery from "../assets/screens/templates-gallery.png";
import Checks from "../components/Checks.astro";
import Icon from "../components/Icon.astro";
import Limit from "../components/Limit.astro";
import PageHero from "../components/PageHero.astro";
import Pillar from "../components/Pillar.astro";
import Screenshot from "../components/Screenshot.astro";
import SectionHead from "../components/SectionHead.astro";
import Stops from "../components/Stops.astro";
import Layout from "../layouts/Layout.astro";
import { spec } from "../lib/links";

type Control = { control: string; how: string; proof: { label: string; href: string } };
const controls: { group: string; rows: Control[] }[] = [
  {
    group: "Identity and access",
    rows: [
      {
        control: "Single sign-on",
        how: "Entra ID, Auth0, SiteMinder or any OIDC or SAML 2.0 IdP, or a trusted SiteMinder-style header. necodoc creates the account at first sign-in.",
        proof: { label: "Single sign-on", href: spec("features/single-sign-on") },
      },
      {
        control: "Role mapping",
        how: "IdP groups map to roles: admin, publisher, reviewer, editor, viewer. A user can hold several roles, and each role grants one kind of work.",
        proof: { label: "Users and roles", href: spec("features/user-management-and-roles") },
      },
      {
        control: "Session control",
        how: "Admins ban users, revoke sessions and reset passwords. Impersonation is admin-only and audited from start to stop.",
        proof: { label: "Users and roles", href: spec("features/user-management-and-roles") },
      },
    ],
  },
  {
    group: "System access",
    rows: [
      {
        control: "Service accounts",
        how: "Keys belong to a person or to a service account that can never sign in.",
        proof: { label: "ADR 0029", href: spec("adrs/0029-service-accounts-and-scoped-api-keys") },
      },
      {
        control: "Scoped keys",
        how: "Each key has scopes no wider than its owner's roles, an optional template allowlist, IP allowlist and expiry date, and a rate limit. Admins can revoke a key and see its usage.",
        proof: { label: "HTML to PDF API", href: spec("features/html-to-pdf-api") },
      },
      {
        control: "Signed callbacks",
        how: "Webhooks carry an HMAC-SHA256 signature over the timestamp and body. necodoc logs each delivery attempt.",
        proof: { label: "Webhooks", href: spec("features/webhooks") },
      },
    ],
  },
  {
    group: "Data",
    rows: [
      {
        control: "Residency",
        how: "Records in your Postgres; PDFs in your S3-compatible bucket, Azure Blob container or disk, in the region you choose.",
        proof: { label: "ADR 0023", href: spec("adrs/0023-generated-outputs-in-object-storage") },
      },
      {
        control: "Downloads",
        how: "Files download through signed links that expire. The audit log records each link that is issued.",
        proof: { label: "Generation log", href: spec("features/generation-log") },
      },
      {
        control: "Retention",
        how: "An admin sets how long generated PDFs, and optionally their input data, are kept.",
        proof: { label: "Generation log", href: spec("features/generation-log") },
      },
    ],
  },
  {
    group: "Audit and logging",
    rows: [
      {
        control: "Audit log",
        how: "Every configuration and access change, sign-ins including failures, impersonation and API key use, with before and after diffs. A database trigger keeps it append-only. Exports to CSV.",
        proof: { label: "Audit log", href: spec("features/audit-log") },
      },
      {
        control: "Generation log",
        how: "Every PDF with its input, output, template version, caller and a timing breakdown; re-runnable against the exact version.",
        proof: { label: "Generation log", href: spec("features/generation-log") },
      },
      {
        control: "Operational logs",
        how: "JSON logs, Prometheus metrics and OpenTelemetry traces, with one request id end to end. Logs and traces never carry field values.",
        proof: { label: "Observability", href: spec("features/observability") },
      },
    ],
  },
  {
    group: "Change control and output",
    rows: [
      {
        control: "Versioning",
        how: "Each template has one working draft. Published versions are numbered and can't change. Publishing needs its own permission.",
        proof: { label: "Publishing", href: spec("features/publishing-and-versions") },
      },
      {
        control: "Review gate",
        how: "When an admin requires it, only an approved, unchanged draft can be published.",
        proof: { label: "Review", href: spec("features/review-and-approval") },
      },
      {
        control: "Regression tests",
        how: "Named test cases with assertions, and a page-by-page visual and text diff against the published version.",
        proof: { label: "Test cases", href: spec("features/template-test-cases-and-visual-diff") },
      },
      {
        control: "Output integrity",
        how: "PDF/A-2b or 2u, PDF/UA-1, and PAdES B-B or B-T certification with your certificate. Each generation records the profiles it applied.",
        proof: {
          label: "Archival output",
          href: spec("features/archival-accessible-and-certified-output"),
        },
      },
    ],
  },
  {
    group: "Privacy and vendor risk",
    rows: [
      {
        control: "Sensitive fields",
        how: "Fields marked sensitive are masked in audit diffs and in other people's log entries.",
        proof: { label: "Personal data", href: spec("features/personal-data-masking-and-erasure") },
      },
      {
        control: "Erasure",
        how: "An admin finds everything stored about a data subject and erases it. necodoc writes an erasure report.",
        proof: { label: "Personal data", href: spec("features/personal-data-masking-and-erasure") },
      },
      {
        control: "Exit",
        how: "MIT source, standard Postgres, PDFs in your storage, templates as data. No vendor holds your data.",
        proof: {
          label: "Licence",
          href: "https://github.com/mikevalstar/necodoc/blob/main/LICENSE",
        },
      },
    ],
  },
];

// The same table as CSV, for the questionnaire (inlined as a data: URL, no script needed).
const csvCell = (s: string) => `"${s.replaceAll('"', '""')}"`;
const csv = [
  "Area,Control,How necodoc does it,Proof",
  ...controls.flatMap((g) =>
    g.rows.map((r) => [g.group, r.control, r.how, r.proof.href].map(csvCell).join(",")),
  ),
].join("\n");
const csvHref = `data:text/csv;charset=utf-8,${encodeURIComponent(csv)}`;
---

<Layout
  title="Security and governance · necodoc"
  description="The controls necodoc provides inside your own boundary: SSO, scoped keys, data residency, an append-only audit log, change control, output integrity and privacy, with their limits."
  page="security"
>
  <PageHero
    crumb="Security and governance"
    eyebrow="Security and governance"
    title="Controls you can check, inside a boundary you already audit."
    toc={[
      { href: "#controls", label: "Controls list" },
      { href: "#audit", label: "Audit and logging" },
      { href: "#change", label: "Change control" },
      { href: "#output", label: "Output, privacy, signatures" },
      { href: "#canada", label: "Canadian requirements" },
      { href: "#not", label: "What we don't claim" },
    ]}
  >
    necodoc runs in your account. People sign in through your IdP, and necodoc writes its records to your Postgres.
    Each control below says how it works and where it stops.
  </PageHero>

  <section class="tight" id="data" style="padding-bottom:0">
    <div class="wrap">
      <div class="callout">
        <Icon name="warning-circle" weight="fill" />
        <div>
          <b>The one thing that can leave your environment is AI, and it's off by default.</b> If an admin sets
          <code>ANTHROPIC_KEY</code>, the template assistant sends the draft template (fields, content, sample data) and AI
          field detection sends page images of the uploaded form to Anthropic's API. Generation data, the policyholder data
          that fills real documents, isn't sent. The audit log records each AI request. Without the key, nothing leaves your
          boundary except the webhooks you configure.
          <a class="tlink" href={spec("features/ai-template-assistant")}>AI template assistant spec</a>
        </div>
      </div>
    </div>
  </section>

  <section id="controls">
    <div class="wrap">
      <SectionHead eyebrow="Controls list" title="Every control, and the spec that defines it.">
        Each spec lists the control's known limits. Download the table as CSV for a vendor questionnaire.
        <span class="cta-row" style="margin-top:20px;display:flex">
          <a class="btn ghost sm" href={csvHref} download="necodoc-controls.csv"><Icon name="download-simple" />Download as CSV</a>
        </span>
      </SectionHead>
      <table class="spec">
        <thead><tr><th>Control</th><th>How necodoc does it</th><th>Proof</th></tr></thead>
        <tbody>
          {
            controls.map((g) => (
              <>
                <tr class="group"><td colspan="3">{g.group}</td></tr>
                {g.rows.map((r) => (
                  <tr>
                    <td>{r.control}</td>
                    <td>{r.how}</td>
                    <td><a href={r.proof.href}>{r.proof.label}</a></td>
                  </tr>
                ))}
              </>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section id="audit" class="alt">
    <div class="wrap">
      <SectionHead eyebrow="Audit and logging" title="Who changed the bond wording, who approved it, and when.">
        The audit log records each change, its diff and who approved it. The generation log records every PDF made from
        each version.
      </SectionHead>
      <div class="pair">
        <Screenshot src={audit} alt="Audit log filtered to template events: review submitted, changes requested, approved, updated" crop={{ height: 470, zoom: 140, x: "-24%", y: "-30px" }} />
        <Screenshot src={auditDetail} alt="Audit entry detail: actor, target, IP, user agent, request id, and a before and after diff" crop={{ height: 470, zoom: 190, x: "-98%" }} />
      </div>
      <div style="margin-top:44px">
        <Stops
          items={[
            { icon: "database", title: "Append-only in the database.", body: "A trigger rejects updates and deletes on audit rows. The app, an API key or a bug can't change a past entry." },
            { icon: "warning", title: "Tamper-resistant, not tamper-evident.", body: "There is no hash chain, and a DBA can disable the trigger. Ship the log to your SIEM if you need proof against your own administrators." },
          ]}
        />
      </div>
    </div>
  </section>

  <section id="change">
    <div class="wrap">
      <Pillar eyebrow="Change control" title="Forms staff change the wording. Your systems code against the fields." flip>
        <p>
          Fields are the contract between a template and your systems. Each published version has its own JSON Schema.
          Review and publishing are separate permissions.
        </p>
        <Checks
          items={[
            "Published versions can't change, and the API always fills a published version",
            "A reviewer sees structure, page and test changes, then approves or asks for changes",
            "Test cases and a visual diff run on the draft before it's published",
            "Shared clauses live in snippets, so you change a clause in one place",
          ]}
        />
        <Limit>One review step. Multi-step approval chains aren't supported.</Limit>
        <Screenshot slot="media" src={gallery} alt="Templates gallery with published versions, drafts and unpublished changes" />
      </Pillar>
    </div>
  </section>

  <section id="output" class="alt tight">
    <div class="wrap">
      <div class="qa">
        <div><p class="q">Output integrity</p><h3>Archival, accessible and certified PDFs</h3><p>PDF/A-2b or 2u for retention, tagged PDF/UA-1 for screen readers, and PAdES certification that shows a recipient if a copy was edited. necodoc doesn't mark a file with a profile it can't meet.</p><a class="tlink" href={spec("features/archival-accessible-and-certified-output")}>Archival output →</a></div>
        <div><p class="q">Privacy</p><h3>Masking and erasure</h3><p>necodoc masks sensitive fields in diffs and in other people's log entries. Admins find and erase a data subject's records, and get a report for the request.</p><a class="tlink" href={spec("features/personal-data-masking-and-erasure")}>Personal data →</a></div>
        <div><p class="q">Signatures</p><h3>E-signature ready</h3><p>Signing packages list signers, routing order and box positions as envelope JSON. Your provider runs the legally binding signing.</p><a class="tlink" href={spec("features/signing-packages")}>Signing packages →</a></div>
      </div>
    </div>
  </section>

  <section id="canada">
    <div class="wrap split">
      <aside>
        <p class="eyebrow">Canadian requirements</p>
        <h2>What helps, and what stays your job.</h2>
        <p>necodoc doesn't make a carrier compliant with anything. These are the features that help you meet each requirement.</p>
      </aside>
      <table class="spec">
        <thead><tr><th>Requirement</th><th>How necodoc helps</th><th>Still yours</th></tr></thead>
        <tbody>
          <tr><td>OSFI B-10<br /><span class="muted small">third-party risk</span></td><td>Self-hosted MIT software: audit and access rights are yours, and the exit plan is your own Postgres and bucket.</td><td>Your third-party assessment and exit testing</td></tr>
          <tr><td>OSFI B-13<br /><span class="muted small">technology and cyber</span></td><td>Runs inside your controls: your IdP, network, keys, logging and patch cycle.</td><td>Operating and patching it</td></tr>
          <tr><td>Bill 96<br /><span class="muted small">Québec, French first</span></td><td>English and fr-CA from one template. Both languages use the same fields and layout, and translations are reviewed with each version.</td><td>Translation quality and legal review. An untranslated string prints in the source language.</td></tr>
          <tr><td>Law 25 · PIPEDA<br /><span class="muted small">privacy</span></td><td>You choose the region; sensitive-field masking; erasure per data subject with a report.</td><td>Privacy assessments, retention policy</td></tr>
          <tr><td>AODA<br /><span class="muted small">accessible formats</span></td><td>Tagged PDF/UA-1 output from designed and HTML documents.</td><td>Accessible content and alt text in templates</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section id="not" class="alt tight">
    <div class="wrap">
      <SectionHead eyebrow="What we don't claim" title="Attestations and claims we don't make.">
        There is no hosted service, so there is nothing for an auditor to attest. necodoc runs inside your SOC 2 and B-13
        boundary and inherits your controls.
      </SectionHead>
      <Stops
        items={[
          { icon: "seal", title: "No SOC 2, ISO 27001 or \"certified secure\".", body: "We describe controls, not attestations." },
          { icon: "lock-key-open", title: "Not \"tamper-proof\".", body: "The audit log is tamper-resistant, as described above." },
          { icon: "signature", title: "Not an e-signature service.", body: "No ESIGN, eIDAS or UECA claims. Your provider signs." },
          { icon: "sparkle", title: "Not \"data never leaves\" without the AI caveat.", body: "With AI off, the default, nothing leaves except your webhooks. The AI caveat is at the top of this page." },
        ]}
      />
    </div>
  </section>
</Layout>

<style>
  .pair { display: grid; grid-template-columns: 1.25fr 1fr; gap: 24px; align-items: start; }
  @media (max-width: 1100px) { .pair { grid-template-columns: 1fr; } }
</style>
