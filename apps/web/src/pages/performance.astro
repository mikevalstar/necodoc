---
// Performance. Its job (docs/features/marketing-site.md, Pages): the W2 numbers with method,
// hardware and the script to reproduce them. Everything here is read from the benchmark's
// JSON (docs/features/performance-benchmark.md); nothing is typed by hand.
import generations from "../assets/screens/generations-log.png";
import BarChart from "../components/BarChart.astro";
import PageHero from "../components/PageHero.astro";
import Pillar from "../components/Pillar.astro";
import Proof from "../components/Proof.astro";
import Provenance from "../components/Provenance.astro";
import Screenshot from "../components/Screenshot.astro";
import SectionHead from "../components/SectionHead.astro";
import Stat from "../components/Stat.astro";
import Stats from "../components/Stats.astro";
import Stops from "../components/Stops.astro";
import Layout from "../layouts/Layout.astro";
import { bench, ms, scaleModel, type BenchValue as Value } from "../lib/bench";
import { spec } from "../lib/links";

const value = (key: string, v: number | null | undefined): Value => {
  const text = ms(v);
  return text ? { text } : { placeholder: `{bench.${key}}` };
};
const n = (v: number) => v.toLocaleString("en-CA");

const latency = bench?.latency ?? [];
const e = bench?.environment;
const environment: [string, string][] = e
  ? [
      ["CPU", `${e.cpu}, ${e.cores} cores`],
      ["Memory", `${e.memoryGb} GB`],
      ["OS", e.os],
      ["Node", e.node],
      ["Chromium", e.chromium],
      ["Postgres", e.postgres.split(" on ")[0] ?? e.postgres],
      ["Storage", e.storage],
      ["Commit", `${e.gitSha.slice(0, 7)}${e.gitDirty ? " (uncommitted changes)" : ""}`],
      ["Load average before", e.loadAverage.join(" / ")],
    ]
  : [];
---

<Layout
  title="Performance · necodoc"
  description="necodoc render latency and batch throughput from a benchmark script anyone can rerun, with the hardware, commit and caveats beside every number."
  page="performance"
>
  <PageHero
    crumb="Performance"
    eyebrow="Performance"
    title="Numbers from a script you can rerun on your own hardware."
    toc={[
      { href: "#latency", label: "Latency" },
      { href: "#throughput", label: "Throughput" },
      { href: "#cold", label: "Cold start and archival" },
      { href: "#method", label: "Method and caveats" },
      { href: "#rerun", label: "Rerun it" },
    ]}
  >
    Every performance figure on this site comes from <code>pnpm bench</code>, which starts a throwaway necodoc stack and
    measures it through the public API. The machine, date and commit sit next to every number.
    <Fragment slot="after"><Provenance method={false} /></Fragment>
  </PageHero>

  <section id="latency">
    <div class="wrap">
      <SectionHead eyebrow="Latency" title="One request at a time, through /api/v1.">
        Client round trip, request sent to last PDF byte, after warm-up. Bars are p50; the whisker runs to p95.
      </SectionHead>
      {
        latency.length > 0 ? (
          <div class="stack">
            <BarChart
              unit="ms"
              caption="Round trip per scenario, p50 bar and p95 whisker, in milliseconds."
              rows={latency.map((l) => ({
                label: l.label,
                value: l.roundTrip.p50 ?? 0,
                whisker: l.roundTrip.p95 ?? undefined,
                text: `${ms(l.roundTrip.p50)} · ${ms(l.roundTrip.p95)}`,
                tip: `${l.label}: p50 ${ms(l.roundTrip.p50)}, p95 ${ms(l.roundTrip.p95)}, p99 ${ms(l.roundTrip.p99)}, ${l.roundTrip.n} samples`,
              }))}
            />
            <table class="spec">
              <thead><tr><th>Scenario</th><th>Pages</th><th>p50</th><th>p95</th><th>p99</th><th>n</th></tr></thead>
              <tbody>
                {latency.map((l) => (
                  <tr>
                    <td>{l.label}</td>
                    <td class="n">{l.pages}</td>
                    <td class="n">{ms(l.roundTrip.p50)}</td>
                    <td class="n">{ms(l.roundTrip.p95)}</td>
                    <td class="n">{ms(l.roundTrip.p99)}</td>
                    <td class="n">{l.roundTrip.n}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="bind">{"{bench.latency}"}: no benchmark run committed yet.</p>
        )
      }
    </div>
  </section>

  <section id="throughput" class="alt">
    <div class="wrap">
      <SectionHead eyebrow="Throughput" title="Batch documents per minute, by worker count.">
        One JSON batch, timed from creation to its last row, queue time included. One worker per server.
      </SectionHead>
      {
        scaleModel ? (
          <div class="stack">
            <BarChart
              unit="docs/min"
              caption="Documents per minute for one batch, by number of workers, one worker per server."
              rows={scaleModel.map((t) => ({
                label: `${t.workers} worker${t.workers > 1 ? "s" : ""}`,
                value: t.docsPerMinute,
                text: n(t.docsPerMinute),
                tip: `${t.workers} worker${t.workers > 1 ? "s" : ""}: ${n(t.docsPerMinute)} docs/min`,
              }))}
            />
            <table class="spec">
              <thead><tr><th>Workers</th><th>Docs/min</th></tr></thead>
              <tbody>
                {scaleModel.map((t) => (
                  <tr>
                    <td>{t.workers}</td>
                    <td class="n">{n(t.docsPerMinute)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="bind">{"{bench.throughput}"}: no benchmark run committed yet.</p>
        )
      }
    </div>
  </section>

  <section id="cold" class="tight">
    <div class="wrap">
      <SectionHead eyebrow="Cold start and archival" title="What a fresh worker and PDF/A cost." />
      <Stats>
        <Stat value={value("coldWarm.cold.p50", bench?.coldWarm.cold.p50)} label="First render, fresh worker">p50, first job once the worker is ready</Stat>
        <Stat value={value("coldWarm.warm.p50", bench?.coldWarm.warm.p50)} label="Same render, warm">p50 on the same worker</Stat>
        <Stat value={value("coldWarm.workerStart.p50", bench?.coldWarm.workerStart.p50)} label="Worker process to ready">p50, includes starting Chromium</Stat>
        <Stat value={value("archival.overheadP50Ms", bench?.archival?.overheadP50Ms)} label="PDF/A-2b + PDF/UA overhead">p50 added to the invoice</Stat>
      </Stats>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <Pillar eyebrow="In production" title="Your own numbers, on every render.">
        <p>
          In production, the generation log records the queue wait, run time and a per-step breakdown for every PDF. Admin ›
          System shows p50, p95 and p99 over a window you select.
        </p>
        <Proof links={[{ label: "Generation log", href: spec("features/generation-log") }]} />
        <Screenshot slot="media" src={generations} alt="Generation log with a render-time histogram and p50, p95 and p99" />
      </Pillar>
    </div>
  </section>

  <section id="method">
    <div class="wrap split">
      <aside>
        <p class="eyebrow">Method and caveats</p>
        <h2>Read these before quoting a number.</h2>
        <p>The full method is in the <a class="tlink" href={spec("features/performance-benchmark")}>benchmark spec</a>.</p>
      </aside>
      <div>
        <Stops
          items={[
            { icon: "laptop", title: "The numbers are for this machine.", body: "A laptop shares its CPU and throttles under sustained load. A server can be faster or slower." },
            { icon: "plug", title: "Everything is local.", body: "Postgres on the same machine with default settings, local disk storage, calls over loopback. No network, S3 or Azure round trips, TLS or proxy." },
            { icon: "files", title: "The test documents are ours.", body: "Render time grows with pages, images, fonts and table size. The test set is typical insurance documents. It isn't a worst case." },
            { icon: "queue", title: "Throughput includes the queue.", body: "Each run is timed from the batch's creation to its last row, so it includes the time a job waits for a worker slot. <code>RENDER_CONCURRENCY</code> sets the slots per worker." },
            { icon: "snowflake", title: "Cold start means a new process.", body: "It measures the first job on a new worker. A worker starts Chromium and opens its pages before it takes jobs. It doesn't measure a container or node cold start." },
            { icon: "arrow-right", title: "Latency is sequential.", body: "One request at a time. It says nothing about latency under concurrent load." },
          ]}
        />
        {
          environment.length > 0 && (
            <table class="spec env">
              <tbody>
                {environment.map(([k, v]) => (
                  <tr><td>{k}</td><td class="n">{v}</td></tr>
                ))}
              </tbody>
            </table>
          )
        }
      </div>
    </div>
  </section>

  <section id="rerun" class="night grid-bg on-night tight">
    <div class="wrap two">
      <div>
        <p class="eyebrow">Rerun it</p>
        <h2>On your hardware, against your Postgres.</h2>
        <p class="lede">The benchmark creates its own database and starts its own processes. It removes both when it ends, even after a failure, and never touches another necodoc install.</p>
      </div>
      <pre class="code"><span class="c"># once: the Chromium build the API pins</span>
pnpm --filter @necodoc/api chromium:install

<span class="c"># the full run (under fifteen minutes on a laptop)</span>
pnpm bench

<span class="c"># samples, batch rows, worker counts, concurrency</span>
pnpm bench --help</pre>
    </div>
  </section>
</Layout>

<style>
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  .two > * { min-width: 0; }
  .stack { display: grid; gap: 40px; }
  .env { margin-top: 32px; }
  .env td:first-child { width: 30%; }
  #rerun pre { border: 1px solid var(--night-hair); }
  @media (max-width: 1100px) { .two { grid-template-columns: 1fr; gap: 32px; } }
</style>
