# ADR 0025: the SPA, same-origin with the API so Better Auth cookies just work.
# ${API_URL} and the resolver are filled in by the image's envsubst step at start.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Re-resolve the API's name, so a recreated API container (new IP) doesn't 502. nginx's resolver
  # ignores DNS search domains: on Kubernetes, API_URL must be the Service's full name.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  location /api/ {
    set $api ${API_URL};
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # 20 MB uploads plus their multipart envelope (ADR 0014).
    client_max_body_size 25m;
    # Synchronous renders wait up to RENDER_WAIT_MS (30 s by default) before answering 202.
    proxy_read_timeout 120s;
    # Downloads stream from storage.
    proxy_buffering off;
  }

  # Hashed build assets never change.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # Client-side routes fall back to the SPA shell, which must not be cached.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
