# necodoc on Docker Compose. Copy to .env and set every "change-me".
# Full reference: apps/devdocs/src/content/docs/self-hosting/configuration.md

# --- Compose ---
POSTGRES_PASSWORD=change-me-postgres
APP_PORT=8080
# SITE_PORT=8081                 # with --profile site
# NECODOC_API_IMAGE=necodoc-api:local
# NECODOC_APP_IMAGE=necodoc-app:local

# --- necodoc (DATABASE_URL is built from POSTGRES_PASSWORD by docker-compose.yml) ---
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
# The URL people open in the browser (the app container, or your TLS proxy in front of it).
BETTER_AUTH_URL=http://localhost:8080
RENDER_CONCURRENCY=2
RENDER_WAIT_MS=30000
PREVIEW_CONCURRENCY=2
APP_VERSION=compose
# The sidebar and login page label: name, and prod | staging | dev. Unset hides it.
# INSTANCE_NAME=Harbour Surety
# INSTANCE_ENV=prod

# --- Logs, metrics, traces (ADR 0036) --- guide: apps/devdocs self-hosting/observability
LOG_LEVEL=info
LOG_FORMAT=json
# Prometheus /metrics on this port of api and workers (not published; Prometheus reaches it inside
# the Compose network). With `--profile monitoring`, Prometheus scrapes it and Jaeger takes traces:
# METRICS_PORT=9464
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# PROMETHEUS_PORT=9090
# JAEGER_PORT=16686

# --- Output storage (ADR 0023) ---
# disk: a named volume shared by api and workers.
STORAGE_DRIVER=disk

# s3 on the bundled MinIO: `docker compose --profile minio up -d`, then use these instead.
# STORAGE_DRIVER=s3
# S3_BUCKET=necodoc
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=necodoc
# S3_SECRET_ACCESS_KEY=change-me-minio

STORAGE_REDIRECT=off
# DOWNLOAD_SIGNING_SECRET=

# --- Sign-in (ADR 0031) --- guides: apps/devdocs self-hosting/sso
# AUTH_PASSWORD_ENABLED=true       # false: SSO only (needs SSO_PROVIDERS)
# SSO_PROVIDERS=entra              # comma list of ids; each id reads SSO_<ID>_* below
# SSO_ENTRA_TYPE=oidc              # oidc | saml | header
# SSO_ENTRA_LABEL=Microsoft
# SSO_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SSO_ENTRA_CLIENT_ID=
# SSO_ENTRA_CLIENT_SECRET=
# SSO_ENTRA_ROLE_MAP='{"<admins-group-id>":["admin"],"<editors-group-id>":["editor","reviewer"]}'
# SSO_ENTRA_DEFAULT_ROLES=         # roles for users in no mapped group; empty = pending
# SSO_ENTRA_LINK_EXISTING=false    # true: may sign in as an existing user with the same email
# SSO_ENTRA_EMAIL_DOMAINS=example.com
