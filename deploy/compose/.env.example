# necodoc on Docker Compose. Copy to .env and set every "change-me".
# Full reference: apps/devdocs/src/content/docs/self-hosting/configuration.md

# --- Compose ---
POSTGRES_PASSWORD=change-me-postgres
APP_PORT=8080
# SITE_PORT=8081                 # with --profile site
# NECODOC_API_IMAGE=necodoc-api:local
# NECODOC_APP_IMAGE=necodoc-app:local

# --- necodoc (DATABASE_URL is built from POSTGRES_PASSWORD by docker-compose.yml) ---
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
# The URL people open in the browser (the app container, or your TLS proxy in front of it).
BETTER_AUTH_URL=http://localhost:8080
RENDER_CONCURRENCY=2
RENDER_WAIT_MS=30000
PREVIEW_CONCURRENCY=2
APP_VERSION=compose

# --- Output storage (ADR 0023) ---
# disk: a named volume shared by api and workers.
STORAGE_DRIVER=disk

# s3 on the bundled MinIO: `docker compose --profile minio up -d`, then use these instead.
# STORAGE_DRIVER=s3
# S3_BUCKET=necodoc
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=necodoc
# S3_SECRET_ACCESS_KEY=change-me-minio

STORAGE_REDIRECT=off
# DOWNLOAD_SIGNING_SECRET=
